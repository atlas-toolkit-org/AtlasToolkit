{
  "format": "atlas-toolkit.workflow",
  "version": 1,
  "name": "Bend Contours",
  "description": "Expressive 3D bending for A3 / 0.3 mm pen-plotter line art.",
  "toolkit": "1.14.0",
  "nodes": [
    {
      "id": "in1",
      "type": "input",
      "label": "",
      "pos": [
        0.0,
        0.0
      ],
      "kind": "mesh",
      "mode": "batch",
      "path": ""
    },
    {
      "id": "n1",
      "type": "tool",
      "label": "",
      "pos": [
        240.0,
        0.0
      ],
      "tool": "mesh-bend",
      "tool_version": "0.1.0",
      "values": {
        "profile": "soft",
        "angle": 70.0,
        "direction": 0.0,
        "amount": 1.0,
        "waves": 1.5,
        "bend_axis": "z",
        "bend_from": 0.0,
        "bend_to": 100.0,
        "anchor": "base",
        "neutral_u": 0.0,
        "neutral_v": 0.0,
        "sweep": 0.0,
        "roll": 0.0,
        "fold_guard": true,
        "refine": true,
        "segments": 48,
        "max_faces": 1000000,
        "stages": 1,
        "save_stages": true,
        "layout": "final",
        "axis": "x",
        "gap": 15.0,
        "up_axis": "auto",
        "front": "auto",
        "rotate": [
          0.0,
          0.0,
          0.0
        ]
      },
      "format": ""
    },
    {
      "id": "n2",
      "type": "tool",
      "label": "",
      "pos": [
        480.0,
        0.0
      ],
      "tool": "contour-lines",
      "tool_version": "1.0.1",
      "values": {
        "theta": 72.4,
        "psi": 148.0,
        "radius": 262.0,
        "lookat": [
          0.0,
          0.0,
          0.0
        ],
        "fov": 36.2,
        "projection": "perspective",
        "spacing_mm": 1.4,
        "hidden": true,
        "slice_offset": 0.0,
        "up_axis": "auto",
        "front": "auto",
        "rotate": [
          0.0,
          0.0,
          0.0
        ],
        "normalise": "set",
        "reference_mesh": "",
        "min_len": 4.0,
        "min_gap": 0.45,
        "join_any": 0.5,
        "join_same": 1.5,
        "gap_bridge": 1.5,
        "paper": "A3",
        "orientation": "landscape",
        "margin": 25.0,
        "paper_width": 200.0,
        "paper_height": 200.0,
        "line_width": 0.3,
        "optimise": true,
        "step_mm": 0.25,
        "simplify": 0.08,
        "draft_faces": 150000
      },
      "format": ""
    },
    {
      "id": "out1",
      "type": "save",
      "label": "",
      "pos": [
        720.0,
        0.0
      ],
      "where": "next",
      "folder": "",
      "name": "{name}"
    }
  ],
  "edges": [
    {
      "from": "in1",
      "to": "n1",
      "port": "in"
    },
    {
      "from": "n1",
      "to": "n2",
      "port": "in"
    },
    {
      "from": "n2",
      "to": "out1",
      "port": "in"
    }
  ],
  "exposed": [
    {
      "node": "n1",
      "key": "profile"
    },
    {
      "node": "n1",
      "key": "angle"
    },
    {
      "node": "n1",
      "key": "direction"
    },
    {
      "node": "n1",
      "key": "bend_from"
    },
    {
      "node": "n1",
      "key": "bend_to"
    },
    {
      "node": "n1",
      "key": "anchor"
    },
    {
      "node": "n1",
      "key": "sweep"
    },
    {
      "node": "n1",
      "key": "roll"
    }
  ]
}