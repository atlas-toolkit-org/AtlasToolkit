{
  "format": "atlas-toolkit.workflow",
  "version": 1,
  "name": "Bend Sketch",
  "description": "Expressive 3D bending for A3 / 0.3 mm pen-plotter line art.",
  "toolkit": "1.14.0",
  "nodes": [
    {
      "id": "in1",
      "type": "input",
      "label": "",
      "pos": [
        0.0,
        0.0
      ],
      "kind": "mesh",
      "mode": "batch",
      "path": ""
    },
    {
      "id": "n1",
      "type": "tool",
      "label": "",
      "pos": [
        240.0,
        0.0
      ],
      "tool": "mesh-bend",
      "tool_version": "0.1.0",
      "values": {
        "profile": "soft",
        "angle": 100.0,
        "direction": -30.0,
        "amount": 1.0,
        "waves": 1.5,
        "bend_axis": "z",
        "bend_from": 0.0,
        "bend_to": 100.0,
        "anchor": "base",
        "neutral_u": 0.0,
        "neutral_v": 0.0,
        "sweep": 150.0,
        "roll": 40.0,
        "fold_guard": true,
        "refine": true,
        "segments": 48,
        "max_faces": 1000000,
        "stages": 1,
        "save_stages": true,
        "layout": "final",
        "axis": "x",
        "gap": 15.0,
        "up_axis": "auto",
        "front": "auto",
        "rotate": [
          0.0,
          0.0,
          0.0
        ]
      },
      "format": ""
    },
    {
      "id": "n2",
      "type": "tool",
      "label": "",
      "pos": [
        480.0,
        0.0
      ],
      "tool": "sketch-hatching",
      "tool_version": "1.0.1",
      "values": {
        "theta": 80.0,
        "psi": 155.0,
        "radius": 262.0,
        "lookat": [
          0.0,
          0.0,
          0.0
        ],
        "fov": 38.0,
        "projection": "perspective",
        "complexity": 0.5,
        "hatching": true,
        "density": 1.0,
        "field": "principal",
        "outline_weight": 0.16,
        "wobble": 0.07,
        "seed": 7,
        "light_az": -40.0,
        "light_el": 40.0,
        "ambient": 0.42,
        "light_frame": "camera",
        "shadows": true,
        "softness": 3.0,
        "key": 0.85,
        "ao": 0.6,
        "form_shading": 0.7,
        "gamma": 1.0,
        "tone_blur": 0.8,
        "suggestive": true,
        "suggestive_strength": 3.0,
        "valleys": true,
        "valley_strength": 110.0,
        "creases": true,
        "crease_angle": 55.0,
        "lost_found": true,
        "passes": 3,
        "tone_scheme": "classic",
        "angle": 45.0,
        "max_len": 45.0,
        "min_len": 2.5,
        "edge_gap": 0.35,
        "focus": false,
        "focus_u": 0.5,
        "focus_v": 0.3,
        "focus_radius": 8.5,
        "focus_light_az": 25.0,
        "focus_light_el": 55.0,
        "up_axis": "auto",
        "front": "auto",
        "rotate": [
          0.0,
          0.0,
          0.0
        ],
        "normalise": "set",
        "reference_mesh": "",
        "paper": "A3",
        "orientation": "portrait",
        "margin": 18.0,
        "fine_width": 0.2,
        "bold_width": 0.4,
        "max_ink": 0.0,
        "px_per_mm": 5.0,
        "draft_faces": 150000
      },
      "format": ""
    },
    {
      "id": "out1",
      "type": "save",
      "label": "",
      "pos": [
        720.0,
        0.0
      ],
      "where": "next",
      "folder": "",
      "name": "{name}"
    }
  ],
  "edges": [
    {
      "from": "in1",
      "to": "n1",
      "port": "in"
    },
    {
      "from": "n1",
      "to": "n2",
      "port": "in"
    },
    {
      "from": "n2",
      "to": "out1",
      "port": "in"
    }
  ],
  "exposed": [
    {
      "node": "n1",
      "key": "profile"
    },
    {
      "node": "n1",
      "key": "angle"
    },
    {
      "node": "n1",
      "key": "direction"
    },
    {
      "node": "n1",
      "key": "bend_from"
    },
    {
      "node": "n1",
      "key": "bend_to"
    },
    {
      "node": "n1",
      "key": "anchor"
    },
    {
      "node": "n1",
      "key": "sweep"
    },
    {
      "node": "n1",
      "key": "roll"
    }
  ]
}
