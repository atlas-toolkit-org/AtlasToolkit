root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{py,pyw}]
indent_size = 4
max_line_length = 120

[*.{cpp,h,hpp}]
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[*.{json,toml,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
